---
import NavButton from "./NavButton.astro";
---

<div class="back-btn">
  <NavButton
    href="javascript:history.back()"
    img="back-button.jpg"
    label=""
  />
</div>

<style>
  .back-btn {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    width: 10rem;
    height: 10rem;
    cursor: pointer;
    display: block;
    z-index: 9999;
  }

  .back-btn .nav-button {
    flex: none;
    aspect-ratio: auto;
    width: 100%;
    height: 100%;
    text-indent: 0;
  }

  .back-btn .nav-label {
    display: none;
  }
</style>