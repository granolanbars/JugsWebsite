      }
      .join-button:focus {
        outline: 0;
      }
      .join-button:hover, .join-button:focus {
        -webkit-transition: background-color 1s linear;
        -ms-transition: background-color 1s linear;
        transition: background-color 1s linear;
        opacity: 0.5;
        transform: scale(1.08);
      }
      .join-button:hover span {
        opacity: 1;
