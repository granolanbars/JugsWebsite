    <script type="text/javascript">
      function openWin(e) {
        e.preventDefault();
        const emailInput = document.getElementById('email');
        let emailVal = '';

        if (emailInput) {
          const errMsg = document.getElementById('errorMessage');
          errMsg.style.display = 'none';
          emailVal = emailInput.value;

          const regex = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;

          if (!emailVal || !regex.test(emailVal)) {
            errMsg.style.display = 'flex';
            return false;
          }
        }

        window.open(
          'https://www.bandsintown.com/artist-subscribe/15638741?locale=en&came_from=701&utm_medium=web&utm_source=email_signup_form&utm_campaign=subscribe&bg-color=rgba%28255%2C255%2C255%2C1%29&cta-bg-color=rgba%28208%2C2%2C27%2C1%29&cta-border-width=2px&cta-border-radius=4px&cta-border-color=rgba%28208%2C2%2C27%2C1%29&cta-text-color=rgba%28255%2C255%2C255%2C1%29&font=Comic+Sans+MS&text-color=rgba%280%2C0%2C0%2C1%29&spn=0&signature=ZZef4b401e5476670099672aa86761d07c6cadb0ca9874ce8dec0171b4296b6cc9&newsletter_email='
          + (emailInput ? encodeURIComponent(emailVal) : '')
        );
      }
    </script>
