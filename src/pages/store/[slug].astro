---
import fs from "node:fs";
import path from "node:path";
import BackButton from "../../components/navigation/BackButton.astro";

// Generate all valid slugs at build time
export async function getStaticPaths() {
  const storeBase = "src/content/store";

  const folders = fs.readdirSync(storeBase).filter((name) => {
    const full = path.join(storeBase, name);
    return fs.statSync(full).isDirectory();
  });

  return folders.map((folder) => ({
    params: { slug: folder }
  }));
}

// Now your existing slug-page code:
const slug = Astro.params.slug;

if (!slug) {
  throw new Error("Slug is undefined — make sure you're visiting /store/[slug]");
}

const storeBase = "src/content/store";
const productFolder = path.join(storeBase, slug);

if (!fs.existsSync(productFolder)) {
  throw new Error(`Product not found: ${slug}`);
}

const dataPath = path.join(productFolder, "data.json");
const data = JSON.parse(fs.readFileSync(dataPath, "utf-8"));

const coverImage = `${data.images}/${data.cover}`;

const publicImageFolder = `public${data.images}`;
let galleryImages: string[] = [];

if (fs.existsSync(publicImageFolder)) {
  galleryImages = fs
    .readdirSync(publicImageFolder)
    .filter((file) => file !== data.cover)
    .map((file) => `${data.images}/${file}`);
}
---

<main class="product-page">
  <div class="product-images">
    <img class="cover" src={coverImage} alt={data.title} />

    {galleryImages.length > 0 && (
      <div class="gallery">
        {galleryImages.map((img) => (
          <img src={img} alt={data.title} />
        ))}
      </div>
    )}
  </div>

  <div class="product-info">
    <h1>{data.title}</h1>
    <p class="price">${data.price}</p>

    <!-- Mock-up Buy Button -->
    <button class="buy-button" disabled>
      Buy (coming soon)
    </button>
  </div>
</main>

<style>
  .product-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 2rem;
  }

  .cover {
    width: 100%;
    border-radius: 8px;
  }

  .gallery {
    margin-top: 1rem;
    display: flex;
    gap: 1rem;
  }

  .gallery img {
    width: 120px;
    border-radius: 6px;
  }

  .product-info h1 {
    margin: 0;
  }

  .price {
    font-size: 1.5rem;
    margin: 1rem 0;
  }

  .buy-button {
    padding: 0.75rem 1.5rem;
    background: #ccc;
    border: none;
    border-radius: 6px;
    cursor: not-allowed;
    opacity: 0.6;
  }
</style>
