---
import HomeLogo from "../components/basic/HomeLogo.astro";
import ScaleEffect from "./ScaleEffect.astro";
import '../styles/global.css';
import BackgroundImg from '../components/basic/BackgroundImg.astro'


const { title = "The Jugs" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <link rel="shortcut icon" sizes="518x518" type="image/png" href="/heart.png" />

  </head>

  <body>
    <BackgroundImg src="background.jpg" alt="Many galaxies in space">
      <div class="content">
        <ScaleEffect>
          <HomeLogo />
        </ScaleEffect>
        <slot />
        
      </div>
    </BackgroundImg>
  </body>
</html>

<style>
  .content {
    padding: clamp(1rem, 4vw, 3rem);
    }
  body {
    margin: 0;
    background: #fff;
  }
</style>